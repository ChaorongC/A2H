#!/bin/bash
#SBATCH --job-name=a2h_rev_cv
#SBATCH -p standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --array=0-99
#SBATCH --chdir=.
#SBATCH --output=results/atlas_cv_full/log/%x_%A_%a.out
#SBATCH --error=results/atlas_cv_full/log/%x_%A_%a.err

set -euo pipefail
: "${BRANCH:?Set BRANCH=historical_sample or donor_grouped when submitting}"
: "${MATRIX_BRANCH:?Set MATRIX_BRANCH=original or depth10 when submitting}"
: "${SLURM_ARRAY_TASK_ID:?Run as a Slurm array task}"

export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export MPLCONFIGDIR="${SLURM_TMPDIR:-/tmp}/a2h_mpl_${SLURM_JOB_ID}"
export XDG_CACHE_HOME="${SLURM_TMPDIR:-/tmp}/a2h_cache_${SLURM_JOB_ID}"

PYTHON=python
SPLIT=$(printf '%03d' "${SLURM_ARRAY_TASK_ID}")
"${PYTHON}" -m src.run_atlas_cv_split \
  --shard-dir "results/atlas_shards_${MATRIX_BRANCH}_full" \
  --split-dir results/atlas_splits \
  --output-dir "results/atlas_cv_full/${MATRIX_BRANCH}/${BRANCH}_split${SPLIT}" \
  --branch "${BRANCH}" \
  --split-index "${SLURM_ARRAY_TASK_ID}" \
  --min-train 50
