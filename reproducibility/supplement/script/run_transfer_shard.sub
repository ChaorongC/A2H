#!/bin/bash
#SBATCH --job-name=a2h_rev_transfer
#SBATCH -p standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=20G
#SBATCH --time=08:00:00
#SBATCH --chdir=.
#SBATCH --output=results/transfer_full/log/%x_%A_%a.out
#SBATCH --error=results/transfer_full/log/%x_%A_%a.err

set -euo pipefail
: "${MODEL:?Set MODEL to a frozen model from reference_models.tsv}"
: "${SLURM_ARRAY_TASK_ID:?Submit as a shard array}"
MEMBERSHIP="${MEMBERSHIP:-results/transfer_manifest/reference_membership.tsv}"
ROOT="${ROOT:-results/transfer_full}"
SHARD_DIR="${SHARD_DIR:-results/atlas_shards_original_full}"
EXTERNAL_DIR="${EXTERNAL_DIR:-results/transfer_external_shards}"

export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export MPLCONFIGDIR="${SLURM_TMPDIR:-/tmp}/a2h_mpl_${SLURM_JOB_ID}"
export XDG_CACHE_HOME="${SLURM_TMPDIR:-/tmp}/a2h_cache_${SLURM_JOB_ID}"

python -m src.run_transfer_shard \
  --shard-dir "${SHARD_DIR}" \
  --external-dir "${EXTERNAL_DIR}" \
  --membership "${MEMBERSHIP}" \
  --samples results/atlas_splits/atlas_samples.tsv \
  --model "${MODEL}" --shard-index "${SLURM_ARRAY_TASK_ID}" \
  --output-dir "${ROOT}/${MODEL}/shard_$(printf '%04d' "${SLURM_ARRAY_TASK_ID}")"
