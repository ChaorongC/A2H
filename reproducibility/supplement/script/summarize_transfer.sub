#!/bin/bash
#SBATCH --job-name=a2h_rev_transfer_sum
#SBATCH -p standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=24G
#SBATCH --time=04:00:00
#SBATCH --chdir=.
#SBATCH --output=results/transfer_full/log/%x_%j.out
#SBATCH --error=results/transfer_full/log/%x_%j.err

set -euo pipefail
: "${MODEL:?Set MODEL to a frozen transfer model}"
ROOT="${ROOT:-results/transfer_full}"

export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export MPLCONFIGDIR="${SLURM_TMPDIR:-/tmp}/a2h_mpl_${SLURM_JOB_ID}"
export XDG_CACHE_HOME="${SLURM_TMPDIR:-/tmp}/a2h_cache_${SLURM_JOB_ID}"

python -m src.summarize_transfer \
  --root "${ROOT}" --model "${MODEL}" \
  --output-dir "${ROOT}/${MODEL}/summary" \
  --expected-shards 52 --min-subjects 8 \
  --pairs results/pgpuk_depth10_calibrated/pairs.tsv
