#!/bin/bash
# GSE240482 external evaluation step (src/gse240482_external.py). Required env: ACTION
# (prepare | truth | transform | evaluate | wgbs-input). truth runs as an array 0-5 (one tumour each).
#SBATCH --job-name=gse240482_ext
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --chdir=.

set -euo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export MPLCONFIGDIR=${TMPDIR:-/tmp}/mpl_$SLURM_JOB_ID XDG_CACHE_HOME=${TMPDIR:-/tmp}/cache_$SLURM_JOB_ID
PY=python
if [[ ${ACTION:?} == truth ]]; then
    "$PY" -m src.gse240482_external truth --index "${SLURM_ARRAY_TASK_ID:?}"
else
    "$PY" -m src.gse240482_external "$ACTION"
fi
