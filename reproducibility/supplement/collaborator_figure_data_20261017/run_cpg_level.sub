#!/bin/bash
#SBATCH -p standard
#SBATCH -n 1
#SBATCH -c 2
#SBATCH --mem=48G
#SBATCH -t 06:00:00
#SBATCH --chdir=.
#SBATCH -o collaborator_figure_data_20261017/log/%x.%j.out
#SBATCH -e collaborator_figure_data_20261017/log/%x.%j.err
# PART: main | addon-e1 | addon-callers. Builds, checks and zips one part of cpg_level_20261018.
set -euo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 MPLCONFIGDIR=${TMPDIR:-/tmp}/mpl
D=collaborator_figure_data_20261017
python $D/build_cpg_level_package.py $PART
case $PART in main) N=A2H_cpg_level_20261018;; addon-e1) N=A2H_addon_E1_predictions_20261018;;
  addon-callers) N=A2H_addon_R2-2_per_sample_caller_tables_20261018;;
  gse240482) N=A2H_cpg_level_GSE240482_20261018;; esac
cd $D/cpg_level_20261018 && zip -q -r -X -0 $N.zip $N && unzip -tq $N.zip && sha256sum $N.zip > $N.zip.sha256
